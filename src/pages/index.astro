---
import Layout from "@/layouts/Layout.astro";
import HomeIsland from "@/components/HomeIsland";
import { sanityClient } from "sanity:client";
import { urlFor } from "@/lib/sanityImage";

interface Article {
  slug: string;
  title: string;
  tags: string[];
  date: string;
  cover: unknown;
}

const sanityArticles: Article[] = await sanityClient.fetch(
  `*[_type == "article" && !draft && defined(slug.current)] | order(date desc){
    "slug": slug.current, title, tags, date, cover
  }`
);

const articles = sanityArticles.map((article) => ({
  slug: article.slug,
  title: article.title,
  tags: article.tags ?? [],
  cover: urlFor(article.cover).width(800).auto("format").url(),
}));

const categories = [...new Set(articles.flatMap((article) => article.tags))];
---

<Layout>
  <HomeIsland client:load articles={articles} categories={categories} />
</Layout>

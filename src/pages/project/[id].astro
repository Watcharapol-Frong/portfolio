---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar";
import FloatingNav from "@/components/FloatingNav";
import { projects, getProjectById } from "@/data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
  }));
}

const { id } = Astro.params;
const project = getProjectById(id!);

if (!project) {
  return Astro.redirect("/404");
}

const currentIndex = projects.findIndex((p) => p.id === project.id);
const prevProject = currentIndex > 0 ? projects[currentIndex - 1] : null;
const nextProject = currentIndex < projects.length - 1 ? projects[currentIndex + 1] : null;
---

<Layout title={`${project.title} — Jordan Studio`} description={project.description}>
  <main class="min-h-screen bg-background page-transition">
    <Navbar client:load />

    {/* Hero Image */}
    <section class="pt-20 px-4 md:px-6">
      <div class="w-full h-[40vh] md:h-[80vh] overflow-hidden rounded-2xl md:rounded-3xl fade-in-up">
        <img
          src={project.images[0]}
          alt={project.title}
          class="w-full h-full object-cover"
        />
      </div>
    </section>

    {/* Project Info */}
    <section class="py-8 px-6">
      <div class="max-w-4xl">
        <div class="mb-6 fade-in-up fade-in-up-delay-1">
          <h1 class="text-display mb-3">{project.title}</h1>
          <p class="text-sm text-muted-foreground">
            {project.tags.map((tag) => `#${tag}`).join(" ")}
          </p>
        </div>

        <div class="grid grid-cols-3 gap-6 mb-8 fade-in-up fade-in-up-delay-2">
          <div>
            <p class="text-xs uppercase tracking-widest text-muted-foreground mb-1">Year</p>
            <p class="text-sm">{project.year}</p>
          </div>
          {project.client && (
            <div>
              <p class="text-xs uppercase tracking-widest text-muted-foreground mb-1">Client</p>
              <p class="text-sm">{project.client}</p>
            </div>
          )}
          <div>
            <p class="text-xs uppercase tracking-widest text-muted-foreground mb-1">Category</p>
            <p class="text-sm capitalize">{project.tags[0]}</p>
          </div>
        </div>

        <div class="max-w-2xl fade-in-up fade-in-up-delay-3">
          <p class="text-lg leading-relaxed text-foreground/90">{project.description}</p>
        </div>
      </div>
    </section>

    {/* Gallery */}
    <section class="py-6 px-6">
      <div class="space-y-4">
        {project.images.slice(1).map((image, index) => (
          <div
            class="w-full overflow-hidden rounded-3xl fade-in-up"
            style={{ animationDelay: `${(index + 4) * 100}ms` }}
          >
            <img
              src={image}
              alt={`${project.title} - ${index + 2}`}
              class="w-full h-auto object-cover"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </section>

    {/* Navigation */}
    <section class="py-12 px-6 border-t border-border">
      <div class="flex items-center justify-between">
        {prevProject ? (
          <a
            href={`/project/${prevProject.id}`}
            class="group flex items-center gap-3 text-left hover:opacity-70 transition-opacity duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-2 transition-transform duration-300"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            <div>
              <p class="text-xs uppercase tracking-widest text-muted-foreground">Previous</p>
              <p class="text-sm">{prevProject.title}</p>
            </div>
          </a>
        ) : (
          <div />
        )}

        {nextProject ? (
          <a
            href={`/project/${nextProject.id}`}
            class="group flex items-center gap-3 text-right hover:opacity-70 transition-opacity duration-300"
          >
            <div>
              <p class="text-xs uppercase tracking-widest text-muted-foreground">Next</p>
              <p class="text-sm">{nextProject.title}</p>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-2 transition-transform duration-300"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        ) : (
          <div />
        )}
      </div>
    </section>
  </main>
  <FloatingNav client:load />
</Layout>

---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Page not found — frong.me">
  <main class="min-h-screen bg-background flex items-center justify-center px-6">
    <div class="text-center">
      <h1 class="text-headline mb-4">404</h1>
      <p class="text-muted-foreground mb-6">Oops! Page not found</p>
      <a href="/" class="text-sm text-foreground underline hover:opacity-70 transition-opacity">
        Return to Home
      </a>
    </div>
  </main>
</Layout>

---
import { Image } from "astro:assets";

interface Props {
  href: string;
  title: string;
  cover: ImageMetadata;
  tags: string[];
}

const { href, title, cover, tags } = Astro.props;
---

<a href={href} class="project-card group block mb-4 break-inside-avoid">
  <div class="relative overflow-hidden rounded-3xl bg-muted">
    <Image
      src={cover}
      alt={title}
      class="w-full h-auto object-cover"
      loading="lazy"
    />
  </div>
  <div class="pt-3 pb-4">
    <h3 class="text-sm font-medium group-hover:opacity-70 transition-opacity duration-300">
      {title}
    </h3>
    <p class="text-xs text-muted-foreground mt-0.5">
      {tags.map((tag) => `#${tag}`).join(" ")}
    </p>
  </div>
</a>

---
import { slugify } from "@/lib/slugify";

const { node } = Astro.props as { node: { style?: string; children?: { text?: string }[] } };
const text = (node.children ?? []).map((child) => child.text ?? "").join("");
const slug = slugify(text);
---

{node.style === "h3" ? (
  <h3 id={slug}><slot /></h3>
) : (
  <h2 id={slug}><slot /></h2>
)}
